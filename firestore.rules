rules_version = '2';
// Lim inn i Firebase-konsollen: Firestore Database → Rules → Publish.
// Bytt BYTT_TIL_DIN_EPOST med e-postadressen den første systemadministratoren logger inn med, med små bokstaver.
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null && request.auth.token.email is string; }
    function signedIn() { return authed() && request.auth.token.email_verified == true; }
    function email() { return request.auth.token.email.lower(); }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    // Medlem = har profil. Profilen kan bare lages med bekreftet e-post eller med en hemmelig invitasjonskode.
    function member() { return authed() && exists(userPath()); }
    function me() { return get(userPath()).data; }
    function sys() { return member() && me().rolle == 'systemadmin'; }
    function validUser(d) {
      return d.keys().hasOnly(['name', 'email', 'firma', 'rolle', 'kode'])
        && d.name is string && d.email is string && d.firma is string
        && d.rolle in ['systemadmin', 'firmaadmin', 'leser'];
    }
    function invitePath() { return /databases/$(database)/documents/invites/$(email()); }
    function codePath(k) { return /databases/$(database)/documents/invitekoder/$(k); }
    function byCode(d) {
      return d.get('kode', '') is string && d.get('kode', '').size() >= 12 && exists(codePath(d.kode))
        && get(codePath(d.kode)).data.email == email()
        && get(codePath(d.kode)).data.rolle == d.rolle
        && get(codePath(d.kode)).data.firma == d.firma;
    }
    match /users/{uid} {
      allow get: if authed() && request.auth.uid == uid;
      allow read: if member();
      // Første innlogging: profilen kopieres fra invitasjonen (bekreftet e-post eller invitasjonskode), eller oppstart av første systemadministrator.
      allow create: if authed() && request.auth.uid == uid && validUser(request.resource.data)
        && request.resource.data.email == email()
        && ((signedIn() && exists(invitePath())
              && request.resource.data.rolle == get(invitePath()).data.rolle
              && request.resource.data.firma == get(invitePath()).data.firma)
            || byCode(request.resource.data)
            || (signedIn() && email() == 'john.skaar@skanska.no' && request.resource.data.rolle == 'systemadmin'));
      allow update: if sys() && validUser(request.resource.data);
      allow delete: if sys() && request.auth.uid != uid;
    }
    match /invites/{inviteEmail} {
      allow get: if signedIn() && inviteEmail == email();
      allow delete: if (signedIn() || member()) && inviteEmail == email();
      allow read, write: if sys();
    }
    // Invitasjonskoder: dokument-id-en er selve koden og fungerer som et hemmelig passord. Kan hentes med koden, men ikke listes.
    match /invitekoder/{kode} {
      allow get: if authed();
      allow delete: if sys() || (authed() && resource.data.email == email());
      allow list, create, update: if sys();
    }
    match /config/{docId} {
      allow read: if member();
      allow write: if sys();
    }
    // Arbeidstillatelser: firma-admin kan endre AT-er for eget firma, eller AT-er knyttet til eget firmas aktiviteter.
    function atOwner(d) { return d.firma == me().firma || me().firma in d.get('aktFirmaer', []); }
    match /at/{id} {
      allow read: if member();
      allow create: if sys() || (member() && me().rolle == 'firmaadmin' && atOwner(request.resource.data));
      allow update: if sys() || (member() && me().rolle == 'firmaadmin' && atOwner(resource.data)
        && (request.resource.data.firma == resource.data.firma || me().firma in resource.data.get('aktFirmaer', [])));
      allow delete: if sys() || (member() && me().rolle == 'firmaadmin' && atOwner(resource.data));
    }
    // Avhengigheter mellom aktiviteter: firma-admin kan lage og endre dem når minst én av aktivitetene tilhører eget firma.
    function actFirma(id) { return get(/databases/$(database)/documents/aktiviteter/$(id)).data.firma; }
    function avhOwner(d) { return actFirma(d.fra) == me().firma || actFirma(d.til) == me().firma; }
    match /avhengigheter/{id} {
      allow read: if member();
      allow create: if sys() || (member() && me().rolle == 'firmaadmin' && avhOwner(request.resource.data));
      allow update: if sys() || (member() && me().rolle == 'firmaadmin' && avhOwner(resource.data) && avhOwner(request.resource.data));
      allow delete: if sys() || (member() && me().rolle == 'firmaadmin' && avhOwner(resource.data));
    }
    // Endringslogg: alle som kan endre, skriver nye innslag i eget navn. Innslag kan ikke endres eller slettes. Bare systemadministratorer kan lese.
    match /endringslogg/{id} {
      allow read: if sys();
      allow create: if member() && me().rolle in ['systemadmin', 'firmaadmin'] && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    // Endringsrapporter (fanen Endringslogg): lages når systemadministrator laster inn en ny fremdriftsplan.
    match /planrapporter/{id} {
      allow read: if member();
      allow write: if sys();
    }
    // Hindringer prioritet: alle medlemmer kan lese. Systemadministrator, og firma-admin for hindringer som er laget av
    // eget firma eller gjelder eget firmas aktiviteter, kan lage og endre. Firmaet som eier hindringen kan ikke byttes.
    match /hindringer/{id} {
      allow read: if member();
      allow create: if sys() || (member() && me().rolle == 'firmaadmin' && request.resource.data.firma == me().firma);
      allow update: if sys() || (member() && me().rolle == 'firmaadmin'
        && (resource.data.firma == me().firma || me().firma in resource.data.get('aktFirmaer', []))
        && request.resource.data.firma == resource.data.firma);
      allow delete: if sys() || (member() && me().rolle == 'firmaadmin' && resource.data.firma == me().firma);
    }
    // Dokumenter til metodebeskrivelsene (PDF/Word), lagret i biter under «deler».
    // Systemadministrator, eller firma-admin for firmaet som eier metodebeskrivelsen, kan laste opp og slette.
    function dokEier(d) { return sys() || (member() && me().rolle == 'firmaadmin' && d.get('firma', '') == me().firma); }
    match /mbdok/{id} {
      allow read: if member();
      allow create: if dokEier(request.resource.data);
      allow update: if dokEier(resource.data) && dokEier(request.resource.data);
      allow delete: if dokEier(resource.data);
      match /deler/{n} {
        allow read: if member();
        allow write: if dokEier(get(/databases/$(database)/documents/mbdok/$(id)).data);
      }
    }
    match /aktiviteter/{id} {
      allow read: if member();
      // Firma-admin kan legge inn nye aktiviteter for eget firma (Statustavlen), og slette dem igjen.
      allow create: if sys() || (member() && me().rolle == 'firmaadmin'
        && request.resource.data.firma == me().firma && request.resource.data.get('kilde', '') == 'WRK2');
      allow delete: if sys() || (member() && me().rolle == 'firmaadmin'
        && resource.data.firma == me().firma && resource.data.get('kilde', '') == 'WRK2');
      // Firma-admin kan endre aktiviteter som eies av eget firma eller har AT-er fra eget firma, men ikke flytte dem til et annet firma.
      allow update: if sys() || (member() && me().rolle == 'firmaadmin'
        && (resource.data.firma == me().firma || me().firma in resource.data.get('atFirmaer', []))
        && request.resource.data.firma == resource.data.firma
        && request.resource.data.id == resource.data.id);
    }
  }
}
